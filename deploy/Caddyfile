admin.lingzhiqicheng.com {
  encode zstd gzip

  @root path /
  redir @root /admin/ 302

  @backend path /admin /admin/* /static/* /uploads/campuses/*
  reverse_proxy @backend api:4000

  respond "Not Found" 404
}

api.lingzhiqicheng.com, api-test.lingzhiqicheng.com {
  encode zstd gzip

  @public path /api/public/* /uploads/campuses/* /health
  reverse_proxy @public api:4000

  respond "Not Found" 404
}
