admin.lingzhiqicheng.com {
  encode zstd gzip

  handle / {
    redir /admin/ 302
  }

  handle /admin* {
    reverse_proxy api:4000
  }

  handle /static/* {
    reverse_proxy api:4000
  }

  handle /uploads/campuses/* {
    reverse_proxy api:4000
  }

  handle /uploads/courses/* {
    reverse_proxy api:4000
  }

  handle {
    respond "Not Found" 404
  }
}

api.lingzhiqicheng.com, api-test.lingzhiqicheng.com {
  encode zstd gzip

  handle /api/public/* {
    reverse_proxy api:4000
  }

  handle /uploads/campuses/* {
    reverse_proxy api:4000
  }

  handle /uploads/courses/* {
    reverse_proxy api:4000
  }

  handle /static/courses/* {
    reverse_proxy api:4000
  }

  handle /health {
    reverse_proxy api:4000
  }

  handle {
    respond "Not Found" 404
  }
}
